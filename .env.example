# ==============================================================================
# Environment Configuration Template
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env or configure these variables in your platform settings.
# ==============================================================================

# Gemini AI API Key (Server-side secret, managed via AI Studio / Cloud Run secrets)
GEMINI_API_KEY=

# Cloud Background Removal API Key (Server-side secret, optional)
REMOVE_BG_API_KEY=

# Application Hosted URL
APP_URL=

# Supabase Authentication & Database (Client-Safe Public Anon Key)
# Set your project URL and publishable anon key from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
